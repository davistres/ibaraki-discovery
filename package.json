{
  "name": "ibaraki-discovery",
  "homepage": "https://davistres.github.io/ibaraki-discovery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/server.js",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "setup:coordinates": "node scripts/completeCoordinates.js && node scripts/completeFestivalCoordinates.js",
    "setup:distances": "node scripts/calculateDistances.js",
    "setup:all": "npm run setup:coordinates && npm run setup:distances"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^11.0.5",
    "i18next": "^25.8.11",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.35",
    "prisma": "^6.19.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
