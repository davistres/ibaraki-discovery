// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Model for all categories, tags, regions, etc.
model Category {
  id     Int    @id @default(autoincrement())
  group  String
  nom    String
  nom_en String @default("")
  nom_ja String @default("")

  // One-to-many relations back to Place/Festival
  placesAsRegion        Place[]    @relation("PlaceRegion")
  placesAsVille         Place[]    @relation("PlaceVille")
  placesAsAccessibilite Place[]    @relation("PlaceAccessibilite")
  festivalsAsRegion     Festival[] @relation("FestivalRegion")
  festivalsAsVille      Festival[] @relation("FestivalVille")

  // Many-to-many relations back to Place/Festival
  places    Place[]
  festivals Festival[]
}

model Place {
  id     String @id @unique
  // French (original)
  nom               String
  nomJaponais       String
  description       String
  descriptionLongue String
  adresse           String
  acces             String
  horaires          String
  tarif             String
  dureeVisite       String
  // English translations
  nom_en               String @default("")
  description_en       String @default("")
  descriptionLongue_en String @default("")
  adresse_en           String @default("")
  acces_en             String @default("")
  horaires_en          String @default("")
  tarif_en             String @default("")
  dureeVisite_en       String @default("")
  // Japanese translations
  nom_ja               String @default("")
  description_ja       String @default("")
  descriptionLongue_ja String @default("")
  adresse_ja           String @default("")
  acces_ja             String @default("")
  horaires_ja          String @default("")
  tarif_ja             String @default("")
  dureeVisite_ja       String @default("")

  imagePrincipale String
  images          String
  lat             Float
  lng             Float
  siteWeb         String
  googleMaps      String

  region    Category @relation("PlaceRegion", fields: [region_id], references: [id])
  region_id Int

  ville     Category @relation("PlaceVille", fields: [ville_id], references: [id])
  ville_id  Int

  accessibilite    Category @relation("PlaceAccessibilite", fields: [accessibilite_id], references: [id])
  accessibilite_id Int

  categories Category[]

  distancesFrom Distance[] @relation("DistanceFrom")
  distancesTo   Distance[] @relation("DistanceTo")
}

model Festival {
  id     String @id @unique
  // French (original)
  nom         String
  nomJaponais String
  description String
  lieu        String
  periode     String
  mois        String
  activites   String
  image       String
  lat         Float  @default(0)
  lng         Float  @default(0)
  // English translations
  nom_en         String @default("")
  description_en String @default("")
  lieu_en        String @default("")
  periode_en     String @default("")
  mois_en        String @default("")
  activites_en   String @default("")
  // Japanese translations
  nom_ja         String @default("")
  description_ja String @default("")
  lieu_ja        String @default("")
  periode_ja     String @default("")
  mois_ja        String @default("")
  activites_ja   String @default("")

  region    Category @relation("FestivalRegion", fields: [region_id], references: [id])
  region_id Int

  ville     Category @relation("FestivalVille", fields: [ville_id], references: [id])
  ville_id  Int

  categories Category[]

  distancesFrom Distance[] @relation("DistanceFrom")
  distancesTo   Distance[] @relation("DistanceTo")
}

model Distance {
  id Int @id @default(autoincrement())

  fromType String
  fromId   String
  toType   String
  toId     String

  distanceKm      Float
  durationMinutes Int

  placeFrom    Place?    @relation("DistanceFrom", fields: [placeFromId], references: [id])
  placeFromId  String?
  placeTo      Place?    @relation("DistanceTo", fields: [placeToId], references: [id])
  placeToId    String?
  festivalFrom Festival? @relation("DistanceFrom", fields: [festivalFromId], references: [id])
  festivalFromId String?
  festivalTo   Festival? @relation("DistanceTo", fields: [festivalToId], references: [id])
  festivalToId String?

  @@unique([fromType, fromId, toType, toId])
}
